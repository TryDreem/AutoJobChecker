# ============================================================================
#  AutoChecker — конфигурация. Скопируй в .env и заполни.
#  cp .env.example .env
# ============================================================================

# --- Бот, который присылает тебе вакансии (получить у @BotFather) ----------
BOT_TOKEN=

# --- Твой Telegram user id (получить у @userinfobot) -----------------------
# Только эти id имеют доступ к боту. Через запятую, если несколько.
ADMIN_IDS=

# --- Telegram MTProto: аккаунт-парсер (получить на https://my.telegram.org) -
# Нужен ИМЕННО аккаунт, а не бот: боты не могут читать чужие каналы.
TG_API_ID=0
TG_API_HASH=

# Вариант A — файл сессии (по умолчанию). Первый запуск:
#   python -m app.tools.login
# введёшь номер и код из Telegram, файл создастся сам.
TG_PHONE=
TG_SESSION=autochecker

# Вариант B — уже готовая строка сессии (Telethon StringSession).
# Если заполнено — используется ВМЕСТО файла, TG_PHONE/TG_SESSION и
# python -m app.tools.login не нужны. Это полный доступ к аккаунту:
# храни только в .env, никому не пересылай.
TG_SESSION_STRING=

# --- LLM-классификатор (опционально, бесплатно через Groq) -----------------
# Если ключа нет — бот работает на правилах, просто чуть менее точно.
# LLM вызывается ТОЛЬКО для пограничных постов — их немного, ключ бесплатный.
# Получить ключ: https://console.groq.com/keys (регистрация бесплатная)
GROQ_API_KEY=
LLM_ENABLED=true
# Llama 3.3 70B на инфраструктуре Groq — быстро и без оплаты.
LLM_MODEL=llama-3.3-70b-versatile
# Максимум запросов к LLM в сутки (1 запрос = до 10 постов).
# У бесплатного тарифа Groq есть свой дневной лимит запросов/токенов —
# при его исчерпании бот сам продолжит работать на одних правилах.
LLM_DAILY_LIMIT=800

# --- Пороги релевантности ---------------------------------------------------
# Ниже MIN_SCORE_STORE пост даже не сохраняется в базу.
MIN_SCORE_STORE=25
# Ниже MIN_SCORE_NOTIFY пост лежит в базе, но не присылается в личку.
MIN_SCORE_NOTIFY=55
# Диапазон, в котором подключается LLM (пограничные случаи).
LLM_SCORE_LOW=35
LLM_SCORE_HIGH=75

# --- Расписание -------------------------------------------------------------
# Как часто опрашивать Telegram-каналы (минуты)
TELEGRAM_POLL_MINUTES=12
# Как часто опрашивать биржи и job-борды (минуты)
JOBBOARD_POLL_MINUTES=45
# Глубина первичного сбора при добавлении нового канала (дни)
BACKFILL_DAYS=3
# Сколько сообщений максимум забирать из одного канала за проход
MAX_MESSAGES_PER_CHANNEL=120

# --- Прочее -----------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///data/autochecker.db
LOG_LEVEL=INFO
TIMEZONE=Europe/Warsaw

# --- Upwork (опционально) ---------------------------------------------------
# Ключ бесплатный для личного использования. Как получить:
#   1. upwork.com → Settings → API Access → создать приложение
#   2. Key Type: OAuth 2.0, в описании указать личное использование
#   3. Дождаться одобрения (~неделя)
# В профиле нужен полный адрес и подтверждённая личность, иначе отклонят.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REFRESH_TOKEN=
